{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/match/:slug", "destination": "/match.html?id=:slug" },
    { "source": "/team/:slug", "destination": "/team.html?id=:slug" },
    { "source": "/stadium/:slug", "destination": "/stadium.html?id=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
